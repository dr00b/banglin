{
  "id": "gesture_symptoms",
  "name": "Gesture Log",
  "shortName": "Gesture Log",
  "version": "0.01",
  "description": "Log that something happened, with a severity 1-5, by twisting your wrist. Uses the onboard TensorFlow when a trained model is installed, a rule-based detector otherwise.",
