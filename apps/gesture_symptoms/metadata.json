      "name": "gsym.app.js",
      "url": "app.js"
    },
    {
      "name": "gsym.boot.js",
      "url": "boot.js"
    },
    {
      "name": "gsym.wid.js",
      "url": "widget.js"
    },
    {
      "name": "gsym.settings.js",
      "url": "settings.js"
    },
    {
      "name": "gsym.img",
      "url": "app-icon.js",
      "evaluate": true
    },
    {
      "name": "gsym.counter.js",
      "url": "../../lib/gesture-counter.js"
    }
  ],
  "data": [
    {
      "name": "gsym.json"
