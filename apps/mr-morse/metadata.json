{
  "id": "mr-morse",
  "name": "Mr Morse",
  "shortName": "Mr Morse",
  "version": "0.03",
  "description": "Log that something happened, with a severity 1-5, by tapping the watch. A double tap, a pause, then a single tap arms it; the taps after that are the severity. Rejects patting, knocks and a moving wrist. Uses the accelerometer's own tap detector, so it costs almost no power.",
  "icon": "app.png",
  "tags": "tool,health,widget",
  "type": "app",
  "supports": [
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "storage": [
    {
      "name": "morse.app.js",
      "url": "app.js"
    },
    {
      "name": "morse.boot.js",
      "url": "boot.js"
    },
    {
      "name": "morse.wid.js",
      "url": "widget.js"
    },
    {
      "name": "morse.settings.js",
      "url": "settings.js"
    },
    {
      "name": "morse.rec.js",
      "url": "recorder.js"
    },
    {
      "name": "morse.img",
      "url": "app-icon.js",
      "evaluate": true
    },
    {
      "name": "morse.tapseq.js",
      "url": "../../lib/morse-protocol.js"
    }
  ],
  "data": [
    {
      "name": "morse.json"
    },
    {
      "name": "morse.log.json"
    },
    {
      "name": "morse.rec.json"
    },
    {
      "wildcard": "morse.r*.csv",
      "storageFile": true
    }
  ],
  "screenshots": [
    {
      "url": "screenshot-main.png"
    },
    {
      "url": "screenshot-live.png"
    },
    {
      "url": "screenshot-events.png"
    },
    {
      "url": "screenshot-settings.png"
    },
    {
      "url": "screenshot-widget.png"
    }
  ]
}
