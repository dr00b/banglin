{
  "name": "banglin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test $(find apps -path '*/tests/*.test.js' | tr '\\n' ' ') $(find lib -name '*.test.js' 2>/dev/null | tr '\\n' ' ')",
    "test:emulator": "npx playwright test",
    "test:all": "npm test && npm run test:emulator",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
